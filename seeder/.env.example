# Entorno y Configuración General
APP_ENV=production
APP_TZ=America/Tegucigalpa
APP_BASE_PATH=
MONTO_MAXIMO_APUESTA=5000
CRON_SECRET_KEY=

# Correo (SMTP) — usar los mismos datos que EcoTienda
# Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_SECURE=tls y MAIL_PASS = "contraseña de aplicación"
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=tls
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_FROM_NAME=GoalBet 2026
# Dominio público SIN barra final ni subcarpeta (para los enlaces dentro de los correos)
APP_PUBLIC_URL=https://tu-sitio.alwaysdata.net
# 1 = hay que confirmar el correo para iniciar sesión (producción). 0 = desactivado
EMAIL_VERIFY_REQUIRED=1
# Correo de contacto que se muestra en Términos y Privacidad (público). Si lo dejás vacío dice «el administrador del sitio»
CONTACT_EMAIL=

# Base de datos
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=goalbet2026
DB_USER=
DB_PASS=

# Futbol — https://www.football-data.org/client/register (10 req/min, gratis)
FOOTBALL_DATA_API_KEY=

# Baloncesto/Beisbol/NFL — https://dashboard.api-football.com/register
# La MISMA key sirve para v1.basketball / v1.baseball / v1.american-football.api-sports.io
API_SPORTS_KEY=

# TheSportsDB — key publica de pruebas (3 = tier gratuito demo)
THESPORTSDB_API_KEY=3