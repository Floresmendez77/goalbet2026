# Entorno y Configuración General
APP_ENV=production
APP_TZ=America/Tegucigalpa
APP_BASE_PATH=
MONTO_MAXIMO_APUESTA=5000
CRON_SECRET_KEY=

# Base de datos
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=goalbet2026
