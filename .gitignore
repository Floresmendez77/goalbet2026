# ==============================================================================
# GoalBet2026 - .gitignore (Producción & CI)
# ==============================================================================

# Entorno y Secretos
.env
seeder/.env
*.env
cacert.pem
seeder/cacert.pem

# Logs del Sistema y Seeders
*.log
seeder/logs/
seeder/*.log

# Reportes y Archivos Temporales de Seeders
seeder/aplicar_todos.txt
seeder/dryrun_todos.txt
seeder/resultados_*.txt

# Node y Dependencias
node_modules/
qa/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Cypress Artefactos y Reportes Generados
qa/reports/
qa/cypress/screenshots/
qa/cypress/videos/

# Composer / Vendor
vendor/

# Archivos Temporales de Desarrollo
scratch/

# IDEs y Editores
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
